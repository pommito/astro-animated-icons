---
import { ArrowLeft } from "@grave/animated-icons/astro";
import "../styles/playground.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <title>ArrowLeft playground</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Animated icons / Astro pilot</p>
        <h1>ArrowLeft</h1>
        <p>Hover the link or button. The arrowhead pulls back as the shaft shortens, then both return. The first paint stays still.</p>
      </header>

      <section aria-labelledby="sizes-heading">
        <h2 id="sizes-heading">At reading size</h2>
        <div class="samples">
          <a href="#destination" id="primary" class="control"><ArrowLeft size={14} />Back to articles<span class="size">14 px</span></a>
          <a href="#destination" id="secondary" class="control"><ArrowLeft size={16} />Previous page<span class="size">16 px</span></a>
          <button type="button" class="control"><ArrowLeft size={24} />Go back<span class="size">24 px</span></button>
        </div>
        <p class="note">Each instance listens to its nearest link or button. The native control keeps its accessible name and keyboard focus.</p>
      </section>

      <section aria-labelledby="lifecycle-heading">
        <h2 id="lifecycle-heading">Insert, remove, reconnect</h2>
        <p>These links are cloned from an Astro-rendered template. Their SVG already exists before the browser attaches behavior.</p>
        <div class="actions">
          <button type="button" id="add">Add instance</button>
          <button type="button" id="remove">Remove instance</button>
          <button type="button" id="connection">Disconnect last</button>
        </div>
        <output id="count" aria-live="polite">0 connected instances</output>
        <div id="dynamic" class="samples"></div>
        <template id="instance-template">
          <a href="#destination" class="control"><ArrowLeft size={16} />Dynamic back link</a>
        </template>
      </section>

      <section aria-labelledby="accessibility-heading">
        <h2 id="accessibility-heading">Reduced motion</h2>
        <p id="motion-preference">The arrow stays still when your browser requests reduced motion. Link and button feedback remains available.</p>
        <p class="note">Icons are decorative by default. This standalone example has an accessible label.</p>
        <ArrowLeft label="Left arrow" size="1.5em" color="currentColor" strokeWidth={1.5} class="labeled-example" />
      </section>

      <section id="destination" aria-labelledby="destination-heading">
        <h2 id="destination-heading">Articles</h2>
        <p>The links arrive here with JavaScript enabled or disabled.</p>
        <p class="note"><a href="/single/">Single-icon fixture</a> · <a href="/plain/">Fixture without icons</a></p>
      </section>
    </main>
  </body>
</html>

<script>
  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector<HTMLDivElement>("#dynamic")!;
  const count = document.querySelector<HTMLOutputElement>("#count")!;
  const connection = document.querySelector<HTMLButtonElement>("#connection")!;
  let detached: Element | undefined;

  const updateCount = () => {
    count.value = `${container.childElementCount} connected instances`;
  };

  document.querySelector("#add")!.addEventListener("click", () => {
    container.append(template.content.cloneNode(true));
    updateCount();
  });
  document.querySelector("#remove")!.addEventListener("click", () => {
    container.lastElementChild?.remove();
    updateCount();
  });
  connection.addEventListener("click", () => {
    if (detached) {
      container.append(detached);
      detached = undefined;
      connection.textContent = "Disconnect last";
    } else if (container.lastElementChild) {
      detached = container.lastElementChild;
      detached.remove();
      connection.textContent = "Reconnect last";
    }
    updateCount();
  });
</script>
