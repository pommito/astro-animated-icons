---
import "../comparison-review.css";
interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title></head>
  <body class="comparison-review">
    <nav class="review-navigation" aria-label="Comparison pages">
      <a href="/css-pilot/">Bell &amp; ChevronRight</a>
      <a href="/css-chevrons/">Chevrons</a>
      <a href="/css-capabilities/">Folders &amp; opacity</a>
      <a href="/supported-six/">Six finite cycles</a>
      <a href="/combined-transforms/">Combined transforms</a>
    </nav>
    <header class="review-intro">
      <p class="review-eyebrow">Motion reference / Public CSS icon</p>
      <h1>{title}</h1>
      <p>Hover a size row to play both versions. Use each pair's controls to replay or stop all four sizes.</p>
    </header>
    <div class="review-toolbar" role="group" aria-label="All comparison pairs">
      <strong>All pairs</strong>
      <button type="button" id="play">Play all</button>
      <button type="button" id="stop">Stop all</button>
    </div>
    <main>
      <slot />
      <details class="review-checks">
        <summary>Numerical checks and methodology</summary>
        <div><slot name="checks" /></div>
      </details>
    </main>
    <footer class="review-footer">Visual acceptance remains with the reviewer. <a href="/css-migration/">All migration fixtures</a></footer>
  </body>
</html>
<script>import "../comparison-controls";</script>
