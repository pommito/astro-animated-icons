---
interface Props { slug: string; name: string; }
const { slug, name } = Astro.props;
---
<section data-kind={slug} id={slug} class="comparison-section" aria-labelledby={slug + "-title"}>
  <header class="pair-heading">
    <h2 id={slug + "-title"}>{name}</h2>
    <div role="group" aria-label={name + " playback"}>
      <button type="button" data-pair-play aria-label={"Play " + name + " pair"}>Play pair</button>
      <button type="button" data-pair-stop aria-label={"Stop " + name + " pair"}>Stop pair</button>
    </div>
  </header>
  <slot />
</section>
