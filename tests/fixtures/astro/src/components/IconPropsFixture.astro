---
import type { ArrowLeft } from "@grave/animated-icons/astro";

interface Props {
  Icon: typeof ArrowLeft;
  name: string;
}

const { Icon, name } = Astro.props;
---

<html lang="en">
  <head><title>Icon props fixture</title></head>
  <body>
    <Icon id="scoped" class="icon" title="Back" data-testid="scoped-icon" />
    <Icon id="inline" style={{ color: "rebeccapurple", marginInlineStart: "2em" }} />
    <Icon id="string-style" style="color: green" size={16} />
    <Icon id="class-list" class:list={["icon", { "extra-class": true }]} label={`${name} icon`} />
    <p class="icon">Scoped style control</p>
  </body>
</html>

<style>
  .icon { color: oklch(0.5 0.2 25); margin-inline-start: 2em; }
</style>
