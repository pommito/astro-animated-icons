---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/user-check/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-user-check"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { userCheckPaint } from "../../../../../packages/animated-icons/src/icons/user-check/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-user-check")) customElements.define("grave-reference-user-check", createIconElement(precedingPaintRecipe(userCheckPaint)));
</script>
