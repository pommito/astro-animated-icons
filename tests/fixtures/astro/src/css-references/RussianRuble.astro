---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/russian-ruble/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-russian-ruble"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { russianRublePaint } from "../../../../../packages/animated-icons/src/icons/russian-ruble/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-russian-ruble")) customElements.define("grave-reference-russian-ruble", createIconElement(precedingPaintRecipe(russianRublePaint)));
</script>
