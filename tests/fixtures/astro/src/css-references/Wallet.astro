---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/wallet/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-wallet"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { walletCycle } from "../../../../../packages/animated-icons/src/icons/wallet/cycle";
  import { previousCombinedRecipe } from "./combined-transform";
  if (!customElements.get("grave-reference-wallet")) customElements.define("grave-reference-wallet", createIconElement(previousCombinedRecipe(walletCycle)));
</script>
