---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/route/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-route"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { routePaint } from "../../../../../packages/animated-icons/src/icons/route/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-route")) customElements.define("grave-reference-route", createIconElement(precedingPaintRecipe(routePaint)));
</script>
