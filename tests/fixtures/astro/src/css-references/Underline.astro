---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/underline/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-underline"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { underlinePaint } from "../../../../../packages/animated-icons/src/icons/underline/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-underline")) customElements.define("grave-reference-underline", createIconElement(precedingPaintRecipe(underlinePaint)));
</script>
