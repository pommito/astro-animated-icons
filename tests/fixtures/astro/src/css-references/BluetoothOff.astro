---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/bluetooth-off/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-bluetooth-off"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { bluetoothOffPaint } from "../../../../../packages/animated-icons/src/icons/bluetooth-off/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-bluetooth-off")) customElements.define("grave-reference-bluetooth-off", createIconElement(precedingPaintRecipe(bluetoothOffPaint)));
</script>
