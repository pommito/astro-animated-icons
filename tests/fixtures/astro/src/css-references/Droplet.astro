---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/droplet/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-droplet"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { dropletPaint } from "../../../../../packages/animated-icons/src/icons/droplet/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-droplet")) customElements.define("grave-reference-droplet", createIconElement(precedingPaintRecipe(dropletPaint)));
</script>
