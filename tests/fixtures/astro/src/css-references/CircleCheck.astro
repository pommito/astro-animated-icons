---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/circle-check/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-circle-check"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { circleCheckPaint } from "../../../../../packages/animated-icons/src/icons/circle-check/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-circle-check")) customElements.define("grave-reference-circle-check", createIconElement(precedingPaintRecipe(circleCheckPaint)));
</script>
