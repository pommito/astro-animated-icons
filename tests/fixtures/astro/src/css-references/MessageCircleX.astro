---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/message-circle-x/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-message-circle-x"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { messageCircleXPaint } from "../../../../../packages/animated-icons/src/icons/message-circle-x/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-message-circle-x")) customElements.define("grave-reference-message-circle-x", createIconElement(precedingPaintRecipe(messageCircleXPaint)));
</script>
