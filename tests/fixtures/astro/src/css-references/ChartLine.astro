---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/chart-line/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-chart-line"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { chartLinePaint } from "../../../../../packages/animated-icons/src/icons/chart-line/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-chart-line")) customElements.define("grave-reference-chart-line", createIconElement(precedingPaintRecipe(chartLinePaint)));
</script>
