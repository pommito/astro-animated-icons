---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/receipt/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-receipt"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { receiptPaint } from "../../../../../packages/animated-icons/src/icons/receipt/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-receipt")) customElements.define("grave-reference-receipt", createIconElement(precedingPaintRecipe(receiptPaint)));
</script>
