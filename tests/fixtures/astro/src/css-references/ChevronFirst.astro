import Drawing from "../../../../../packages/animated-icons/src/icons/chevron-first/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-chevron-first"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { chevronFirstRecipe } from "./chevron-first";
