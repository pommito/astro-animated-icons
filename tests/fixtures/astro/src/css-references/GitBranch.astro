---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/git-branch/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-git-branch"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitBranchPaint } from "../../../../../packages/animated-icons/src/icons/git-branch/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-git-branch")) customElements.define("grave-reference-git-branch", createIconElement(precedingPaintRecipe(gitBranchPaint)));
</script>
