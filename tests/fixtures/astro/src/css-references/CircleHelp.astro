---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/circle-help/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-circle-help"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { circleHelpRecipe } from "./circle-help";
  if (!customElements.get("grave-reference-circle-help")) customElements.define("grave-reference-circle-help", createIconElement(circleHelpRecipe));
</script>
