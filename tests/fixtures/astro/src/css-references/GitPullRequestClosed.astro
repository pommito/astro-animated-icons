---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/git-pull-request-closed/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-git-pull-request-closed"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitPullRequestClosedPaint } from "../../../../../packages/animated-icons/src/icons/git-pull-request-closed/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-git-pull-request-closed")) customElements.define("grave-reference-git-pull-request-closed", createIconElement(precedingPaintRecipe(gitPullRequestClosedPaint)));
</script>
