---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/train-track/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-train-track"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { trainTrackPaint } from "../../../../../packages/animated-icons/src/icons/train-track/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-train-track")) customElements.define("grave-reference-train-track", createIconElement(precedingPaintRecipe(trainTrackPaint)));
</script>
