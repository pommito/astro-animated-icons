---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/webhook/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-webhook"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { webhookPaint } from "../../../../../packages/animated-icons/src/icons/webhook/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-webhook")) customElements.define("grave-reference-webhook", createIconElement(precedingPaintRecipe(webhookPaint)));
</script>
