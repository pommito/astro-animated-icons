---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/chevron-up/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-chevron-up"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { chevronUpRecipe } from "./chevron-up";
  if (!customElements.get("grave-reference-chevron-up")) customElements.define("grave-reference-chevron-up", createIconElement(chevronUpRecipe));
</script>
