---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/circle-dollar-sign/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-circle-dollar-sign"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { circleDollarSignPaint } from "../../../../../packages/animated-icons/src/icons/circle-dollar-sign/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-circle-dollar-sign")) customElements.define("grave-reference-circle-dollar-sign", createIconElement(precedingPaintRecipe(circleDollarSignPaint)));
</script>
