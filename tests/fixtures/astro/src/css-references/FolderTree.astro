---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/folder-tree/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-folder-tree"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { folderTreePaint } from "../../../../../packages/animated-icons/src/icons/folder-tree/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-folder-tree")) customElements.define("grave-reference-folder-tree", createIconElement(precedingPaintRecipe(folderTreePaint)));
</script>
