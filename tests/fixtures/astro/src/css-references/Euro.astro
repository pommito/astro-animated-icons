---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/euro/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-euro"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { euroPaint } from "../../../../../packages/animated-icons/src/icons/euro/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-euro")) customElements.define("grave-reference-euro", createIconElement(precedingPaintRecipe(euroPaint)));
</script>
