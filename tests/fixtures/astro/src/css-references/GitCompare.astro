---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/git-compare/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-git-compare"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitComparePaint } from "../../../../../packages/animated-icons/src/icons/git-compare/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-git-compare")) customElements.define("grave-reference-git-compare", createIconElement(precedingPaintRecipe(gitComparePaint)));
</script>
