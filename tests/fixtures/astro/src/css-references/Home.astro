---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/home/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-home"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { homePaint } from "../../../../../packages/animated-icons/src/icons/home/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-home")) customElements.define("grave-reference-home", createIconElement(precedingPaintRecipe(homePaint)));
</script>
