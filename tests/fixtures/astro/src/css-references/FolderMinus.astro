---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/folder-minus/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-folder-minus"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { folderMinusPaint } from "../../../../../packages/animated-icons/src/icons/folder-minus/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-folder-minus")) customElements.define("grave-reference-folder-minus", createIconElement(precedingPaintRecipe(folderMinusPaint)));
</script>
