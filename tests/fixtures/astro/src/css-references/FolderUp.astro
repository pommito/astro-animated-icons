---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/folder-up/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-folder-up"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { folderUpRecipe } from "./folder-up";
  if (!customElements.get("grave-reference-folder-up")) customElements.define("grave-reference-folder-up", createIconElement(folderUpRecipe));
</script>
