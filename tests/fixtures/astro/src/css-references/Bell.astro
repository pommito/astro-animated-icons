---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/bell/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-bell"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { bellRecipe } from "./bell";
  if (!customElements.get("grave-reference-bell")) customElements.define("grave-reference-bell", createIconElement(bellRecipe));
</script>
