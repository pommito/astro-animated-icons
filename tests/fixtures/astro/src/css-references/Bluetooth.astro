---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/bluetooth/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-bluetooth"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { bluetoothPaint } from "../../../../../packages/animated-icons/src/icons/bluetooth/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-bluetooth")) customElements.define("grave-reference-bluetooth", createIconElement(precedingPaintRecipe(bluetoothPaint)));
</script>
