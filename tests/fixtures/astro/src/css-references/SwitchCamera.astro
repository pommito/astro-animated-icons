---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/switch-camera/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-switch-camera"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { switchCameraPaint } from "../../../../../packages/animated-icons/src/icons/switch-camera/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-switch-camera")) customElements.define("grave-reference-switch-camera", createIconElement(precedingPaintRecipe(switchCameraPaint)));
</script>
