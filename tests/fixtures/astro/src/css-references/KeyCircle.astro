---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/key-circle/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-key-circle"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { keyCircleCycle } from "../../../../../packages/animated-icons/src/icons/key-circle/cycle";
  import { previousCombinedRecipe } from "./combined-transform";
  if (!customElements.get("grave-reference-key-circle")) customElements.define("grave-reference-key-circle", createIconElement(previousCombinedRecipe(keyCircleCycle)));
</script>
