---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/circle-dashed/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-circle-dashed"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { circleDashedRecipe } from "./circle-dashed";
  if (!customElements.get("grave-reference-circle-dashed")) customElements.define("grave-reference-circle-dashed", createIconElement(circleDashedRecipe));
</script>
