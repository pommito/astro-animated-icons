---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/gitlab/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-gitlab"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitlabPaint } from "../../../../../packages/animated-icons/src/icons/gitlab/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-gitlab")) customElements.define("grave-reference-gitlab", createIconElement(precedingPaintRecipe(gitlabPaint)));
</script>
