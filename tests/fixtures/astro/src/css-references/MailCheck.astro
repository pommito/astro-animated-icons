---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/mail-check/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-mail-check"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { mailCheckPaint } from "../../../../../packages/animated-icons/src/icons/mail-check/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-mail-check")) customElements.define("grave-reference-mail-check", createIconElement(precedingPaintRecipe(mailCheckPaint)));
</script>
