---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/git-commit-vertical/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-git-commit-vertical"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitCommitVerticalPaint } from "../../../../../packages/animated-icons/src/icons/git-commit-vertical/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-git-commit-vertical")) customElements.define("grave-reference-git-commit-vertical", createIconElement(precedingPaintRecipe(gitCommitVerticalPaint)));
</script>
