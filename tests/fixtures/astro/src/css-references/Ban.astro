---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/ban/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-ban"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { banPaint } from "../../../../../packages/animated-icons/src/icons/ban/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-ban")) customElements.define("grave-reference-ban", createIconElement(precedingPaintRecipe(banPaint)));
</script>
