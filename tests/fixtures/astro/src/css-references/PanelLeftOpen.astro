---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/panel-left-open/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-panel-left-open"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { panelLeftOpenCycle } from "../../../../../packages/animated-icons/src/icons/panel-left-open/cycle";
  import { precedingFiniteRecipe } from "./preceding-finite";
  if (!customElements.get("grave-reference-panel-left-open")) customElements.define("grave-reference-panel-left-open", createIconElement(precedingFiniteRecipe(panelLeftOpenCycle)));
</script>
