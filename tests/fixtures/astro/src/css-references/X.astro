---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/x/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-x"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { xPaint } from "../../../../../packages/animated-icons/src/icons/x/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-x")) customElements.define("grave-reference-x", createIconElement(precedingPaintRecipe(xPaint)));
</script>
