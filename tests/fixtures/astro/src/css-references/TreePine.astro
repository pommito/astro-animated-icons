---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/tree-pine/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-tree-pine"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { treePineCycle } from "../../../../../packages/animated-icons/src/icons/tree-pine/cycle";
  import { precedingFiniteRecipe } from "./preceding-finite";
  if (!customElements.get("grave-reference-tree-pine")) customElements.define("grave-reference-tree-pine", createIconElement(precedingFiniteRecipe(treePineCycle)));
</script>
