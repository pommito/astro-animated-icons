---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/linkedin/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-linkedin"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { linkedinPaint } from "../../../../../packages/animated-icons/src/icons/linkedin/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-linkedin")) customElements.define("grave-reference-linkedin", createIconElement(precedingPaintRecipe(linkedinPaint)));
</script>
