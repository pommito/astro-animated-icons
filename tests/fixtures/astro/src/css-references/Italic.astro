---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/italic/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-italic"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { italicPaint } from "../../../../../packages/animated-icons/src/icons/italic/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-italic")) customElements.define("grave-reference-italic", createIconElement(precedingPaintRecipe(italicPaint)));
</script>
