---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/flame/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-flame"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { flamePaint } from "../../../../../packages/animated-icons/src/icons/flame/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-flame")) customElements.define("grave-reference-flame", createIconElement(precedingPaintRecipe(flamePaint)));
</script>
