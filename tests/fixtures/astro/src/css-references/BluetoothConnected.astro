---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/bluetooth-connected/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-bluetooth-connected"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { bluetoothConnectedPaint } from "../../../../../packages/animated-icons/src/icons/bluetooth-connected/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-bluetooth-connected")) customElements.define("grave-reference-bluetooth-connected", createIconElement(precedingPaintRecipe(bluetoothConnectedPaint)));
</script>
