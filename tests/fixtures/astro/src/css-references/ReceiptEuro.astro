---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/receipt-euro/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-receipt-euro"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { receiptEuroPaint } from "../../../../../packages/animated-icons/src/icons/receipt-euro/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-receipt-euro")) customElements.define("grave-reference-receipt-euro", createIconElement(precedingPaintRecipe(receiptEuroPaint)));
</script>
