---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/calendar-check/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-calendar-check"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { calendarCheckPaint } from "../../../../../packages/animated-icons/src/icons/calendar-check/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-calendar-check")) customElements.define("grave-reference-calendar-check", createIconElement(precedingPaintRecipe(calendarCheckPaint)));
</script>
