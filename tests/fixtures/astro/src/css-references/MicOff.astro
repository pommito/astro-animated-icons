---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/mic-off/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-mic-off"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { micOffPaint } from "../../../../../packages/animated-icons/src/icons/mic-off/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-mic-off")) customElements.define("grave-reference-mic-off", createIconElement(precedingPaintRecipe(micOffPaint)));
</script>
