---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/eye-off/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-eye-off"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { eyeOffPaint } from "../../../../../packages/animated-icons/src/icons/eye-off/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-eye-off")) customElements.define("grave-reference-eye-off", createIconElement(precedingPaintRecipe(eyeOffPaint)));
</script>
