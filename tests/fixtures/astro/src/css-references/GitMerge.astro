---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/git-merge/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-git-merge"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { gitMergePaint } from "../../../../../packages/animated-icons/src/icons/git-merge/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-git-merge")) customElements.define("grave-reference-git-merge", createIconElement(precedingPaintRecipe(gitMergePaint)));
</script>
