---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/wind/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-wind"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { windPaint } from "../../../../../packages/animated-icons/src/icons/wind/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-wind")) customElements.define("grave-reference-wind", createIconElement(precedingPaintRecipe(windPaint)));
</script>
