---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/fingerprint/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-fingerprint"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { fingerprintPaint } from "../../../../../packages/animated-icons/src/icons/fingerprint/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-fingerprint")) customElements.define("grave-reference-fingerprint", createIconElement(precedingPaintRecipe(fingerprintPaint)));
</script>
