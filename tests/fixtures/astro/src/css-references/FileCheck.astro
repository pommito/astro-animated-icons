---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/file-check/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-file-check"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { fileCheckPaint } from "../../../../../packages/animated-icons/src/icons/file-check/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-file-check")) customElements.define("grave-reference-file-check", createIconElement(precedingPaintRecipe(fileCheckPaint)));
</script>
