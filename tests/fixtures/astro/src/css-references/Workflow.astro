---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/workflow/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-workflow"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { workflowPaint } from "../../../../../packages/animated-icons/src/icons/workflow/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-workflow")) customElements.define("grave-reference-workflow", createIconElement(precedingPaintRecipe(workflowPaint)));
</script>
