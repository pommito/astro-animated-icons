---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/user-round-plus/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-user-round-plus"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { userRoundPlusPaint } from "../../../../../packages/animated-icons/src/icons/user-round-plus/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-user-round-plus")) customElements.define("grave-reference-user-round-plus", createIconElement(precedingPaintRecipe(userRoundPlusPaint)));
</script>
