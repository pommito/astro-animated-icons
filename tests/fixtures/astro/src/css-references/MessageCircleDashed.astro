---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/message-circle-dashed/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-message-circle-dashed"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { messageCircleDashedPaint } from "../../../../../packages/animated-icons/src/icons/message-circle-dashed/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-message-circle-dashed")) customElements.define("grave-reference-message-circle-dashed", createIconElement(precedingPaintRecipe(messageCircleDashedPaint)));
</script>
