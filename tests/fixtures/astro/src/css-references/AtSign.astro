---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/at-sign/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-at-sign"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { atSignPaint } from "../../../../../packages/animated-icons/src/icons/at-sign/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-at-sign")) customElements.define("grave-reference-at-sign", createIconElement(precedingPaintRecipe(atSignPaint)));
</script>
