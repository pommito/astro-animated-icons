---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/message-square-plus/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-message-square-plus"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { messageSquarePlusPaint } from "../../../../../packages/animated-icons/src/icons/message-square-plus/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-message-square-plus")) customElements.define("grave-reference-message-square-plus", createIconElement(precedingPaintRecipe(messageSquarePlusPaint)));
</script>
