---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/air-vent/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-air-vent"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { airVentPaint } from "../../../../../packages/animated-icons/src/icons/air-vent/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-air-vent")) customElements.define("grave-reference-air-vent", createIconElement(precedingPaintRecipe(airVentPaint)));
</script>
