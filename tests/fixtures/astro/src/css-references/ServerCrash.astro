---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/server-crash/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-server-crash"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { serverCrashPaint } from "../../../../../packages/animated-icons/src/icons/server-crash/paint";
  import { precedingPaintRecipe } from "./preceding-paint";
  if (!customElements.get("grave-reference-server-crash")) customElements.define("grave-reference-server-crash", createIconElement(precedingPaintRecipe(serverCrashPaint)));
</script>
