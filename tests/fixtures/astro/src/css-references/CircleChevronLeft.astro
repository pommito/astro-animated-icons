---
import Icon, { type IconProps } from "../../../../../packages/animated-icons/src/Icon.astro";
import Drawing from "../../../../../packages/animated-icons/src/icons/circle-chevron-left/Drawing.astro";
type Props = IconProps;
---
<Icon {...Astro.props} tag="grave-reference-circle-chevron-left"><Drawing /></Icon>
<script>
  import { createIconElement } from "../../../../../packages/animated-icons/src/element";
  import { circleChevronLeftRecipe } from "./circle-chevron-left";
