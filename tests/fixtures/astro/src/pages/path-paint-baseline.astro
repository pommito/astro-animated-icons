---
import { pathPaint } from "../path-paint-catalogue";
import { WindArrowDown } from "@grave/animated-icons/astro";
const catalogue=[...pathPaint.map(icon=>({...icon,Component:icon.Reference})),{slug:"wind-arrow-down",name:"WindArrowDown",Component:WindArrowDown}];
---
<html lang="en"><head><meta charset="utf-8" /><title>Preceding Motion path paint references</title></head><body>
<h1>Preceding Motion path paint references</h1><p>Fixture references use current production data through the preceding local Motion mechanisms. Independent pre-extraction captures remain in the dated evidence.</p>
{catalogue.map(({slug,name,Component})=><section data-kind={slug}><h2>{name}</h2>{[14,16,24,28].map(size=><div data-size={size}><Component size={size} controlled data-sample /></div>)}</section>)}
</body></html>
