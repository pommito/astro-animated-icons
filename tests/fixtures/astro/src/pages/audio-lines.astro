---
import { AudioLines } from "@grave/animated-icons/astro";
---

<html lang="en">
  <head><title>AudioLines browser test fixture</title></head>
  <body>
    <p><a href="#destination" id="primary"><AudioLines size={16} />AudioLines example</a></p>
    <button type="button" id="secondary"><AudioLines size={24} />Other audio-lines icon</button>
    <AudioLines id="standalone" label="AudioLines icon" />
    <button type="button" id="controlled"><AudioLines controlled />Manual audio-lines icon</button>
    <button type="button" id="stop-controlled">Stop manual animation</button>
    <button type="button" id="add">Add instance</button>
    <button type="button" id="remove">Remove instance</button>
    <div id="dynamic"></div>
    <template id="instance-template"><a href="#destination"><AudioLines size={16} />Dynamic audio-lines icon</a></template>
    <p id="destination">Example destination</p>
  </body>
</html>

<script>
  import type { AudioLinesIconHandle } from "@grave/animated-icons/astro";

  await customElements.whenDefined("grave-audio-lines");
  const controlled = document.querySelector<HTMLElement & AudioLinesIconHandle>("#controlled grave-audio-lines")!;
  document.querySelector("#controlled")!.addEventListener("click", () => controlled.startAnimation());
  document.querySelector("#stop-controlled")!.addEventListener("click", () => controlled.stopAnimation());
  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector("#dynamic")!;
  document.querySelector("#add")!.addEventListener("click", () => container.append(template.content.cloneNode(true)));
  document.querySelector("#remove")!.addEventListener("click", () => container.lastElementChild?.remove());
</script>
