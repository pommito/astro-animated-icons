---
import { GripVertical } from "@grave/animated-icons/astro";
---

<html lang="en">
  <head><title>GripVertical browser test fixture</title></head>
  <body>
    <p><a href="#destination" id="primary"><GripVertical size={16} />GripVertical example</a></p>
    <button type="button" id="secondary"><GripVertical size={24} />Other grip-vertical icon</button>
    <GripVertical id="standalone" label="GripVertical icon" />
    <button type="button" id="controlled"><GripVertical controlled />Manual grip-vertical icon</button>
    <button type="button" id="stop-controlled">Stop manual animation</button>
    <button type="button" id="add">Add instance</button>
    <button type="button" id="remove">Remove instance</button>
    <div id="dynamic"></div>
    <template id="instance-template"><a href="#destination"><GripVertical size={16} />Dynamic grip-vertical icon</a></template>
    <p id="destination">Example destination</p>
  </body>
</html>

<script>
  import type { GripVerticalIconHandle } from "@grave/animated-icons/astro";

  await customElements.whenDefined("grave-grip-vertical");
  const controlled = document.querySelector<HTMLElement & GripVerticalIconHandle>("#controlled grave-grip-vertical")!;
  document.querySelector("#controlled")!.addEventListener("click", () => controlled.startAnimation());
  document.querySelector("#stop-controlled")!.addEventListener("click", () => controlled.stopAnimation());
  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector("#dynamic")!;
  document.querySelector("#add")!.addEventListener("click", () => container.append(template.content.cloneNode(true)));
  document.querySelector("#remove")!.addEventListener("click", () => container.lastElementChild?.remove());
</script>
