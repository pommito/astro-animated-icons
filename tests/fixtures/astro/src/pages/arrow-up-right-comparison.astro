---
import { ArrowUpRight } from "@grave/animated-icons/astro";
const sizes = [14, 16, 24, 28];
---

<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>ArrowUpRight recipe comparison</title></head>
  <body>
    <h1>ArrowUpRight recipe comparison</h1>
    <p>Hover a sample, or play both columns together. Stop during playback to compare the interrupted return.</p>
    <button type="button" id="play">Play all</button>
    <button type="button" id="stop">Stop all</button>
    <p>The reference uses native keyframes and independently solves the upstream return springs. Both columns inherit interruption velocity. Replay starts a fresh cycle from rest, as in the source. The reference does not execute React.</p>
    <table>
      <thead><tr><th>Size</th><th>Astro adapter</th><th>Recipe reference</th></tr></thead>
      <tbody>
        {sizes.map((size) => (
          <tr data-size={size}>
            <th scope="row">{size} px</th>
            <td><button type="button" data-adapter><ArrowUpRight size={size} />Astro {size} px</button></td>
            <td><button type="button" data-reference>
              <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <g style="transform-box: fill-box; transform-origin: 100% 0%"><path d="M7 7H17" /><path d="M17 7V17" /><path d="M7 17L17 7" /></g>
              </svg>Reference {size} px
            </button></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p><a href="https://lucide-animated.com/">Live Lucide Animated catalogue</a></p>
    <p><a href="https://github.com/pqoqubbw/icons/blob/4662fff2b60fdcf4751b32013606756caf7c4c26/icons/arrow-up-right.tsx">Pinned upstream ArrowUpRight source</a></p>
    <p><a href="/arrow-up-right/">Lifecycle and manual controls</a></p>
  </body>
</html>

<script>
  const references = new Map<Element, Animation>();
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  function reset(control: Element) {
    references.get(control)?.cancel();
    references.delete(control);
  }
  function pose(drawing: SVGGElement) {
    const matrix = new DOMMatrix(getComputedStyle(drawing).transform);
    return [matrix.m41, matrix.m42, matrix.a];
  }
  function play(control: Element, returning = false) {
    const drawing = control.querySelector("g")!;
    const origin = pose(drawing);
    const previousAnimation = references.get(control);
    const time = Number(previousAnimation?.currentTime ?? 0);
    let velocity = [0, 0, 0];
    if (previousAnimation && time > 0) {
      const interval = Math.min(time, 5);
      previousAnimation.currentTime = time - interval;
      const previous = pose(drawing);
      velocity = origin.map((value, index) => (value - previous[index]) * 1000 / interval);
    }
    reset(control);
    if (reducedMotion.matches) return;
    let frames: Keyframe[];
    let duration = 500;
    if (returning) {
      const targets = [0, 0, 1];
      const finished = [false, false, false];
      frames = [{ transform: `translate(${origin[0]}px, ${origin[1]}px) scale(${origin[2]})` }];
      let milliseconds = 0;
      do {
        milliseconds += 5;
        const seconds = milliseconds / 1000;
        const values = origin.map((value, index) => {
          if (finished[index]) return targets[index];
          const decay = index === 2 ? 15 : 12.5;
          const frequency = Math.sqrt((index === 2 ? 550 : 500) - decay ** 2);
          const delta = value - targets[index];
          const coefficient = (velocity[index] + decay * delta) / frequency;
          const cosine = Math.cos(frequency * seconds);
          const sine = Math.sin(frequency * seconds);
          const envelope = Math.exp(-decay * seconds);
          const displacement = envelope * (delta * cosine + coefficient * sine);
          const speed = envelope * ((coefficient * frequency - decay * delta) * cosine - (delta * frequency + decay * coefficient) * sine);
          finished[index] = Math.abs(displacement) <= 0.005 && Math.abs(speed) <= 10;
          return finished[index] ? targets[index] : targets[index] + displacement;
        });
        frames.push({ transform: `translate(${values[0]}px, ${values[1]}px) scale(${values[2]})` });
      } while (!finished.every(Boolean) && milliseconds < 2000);
      duration = milliseconds;
    } else {
      frames = [
        { transform: "translate(0px, 0px) scale(1)", offset: 0, easing: "cubic-bezier(0.42, 0, 0.58, 1)" },
        { transform: "translate(-4px, 4px) scale(0.85)", offset: 0.5, easing: "cubic-bezier(0.42, 0, 0.58, 1)" },
        { transform: "translate(0px, 0px) scale(1)", offset: 1 },
      ];
    }
    const animation = drawing.animate(frames, { duration, fill: "both" });
    references.set(control, animation);
    animation.finished.then(() => {
      if (references.get(control) === animation) reset(control);
    }).catch(() => {});
  }
  for (const control of document.querySelectorAll("[data-reference]")) {
    control.addEventListener("pointerenter", (event) => {
      if ((event as PointerEvent).pointerType !== "touch") play(control);
    });
    control.addEventListener("pointerleave", () => { if (references.has(control)) play(control, true); });
  }
  document.querySelector("#play")!.addEventListener("click", () => {
    document.querySelectorAll("grave-arrow-up-right").forEach((icon) => icon.startAnimation());
    document.querySelectorAll("[data-reference]").forEach((control) => play(control));
  });
  document.querySelector("#stop")!.addEventListener("click", () => {
    document.querySelectorAll("grave-arrow-up-right").forEach((icon) => icon.stopAnimation());
    document.querySelectorAll("[data-reference]").forEach((control) => { if (references.has(control)) play(control, true); });
  });
  reducedMotion.addEventListener("change", () => {
    if (reducedMotion.matches) document.querySelectorAll("[data-reference]").forEach(reset);
  });
  window.addEventListener("pagehide", () => document.querySelectorAll("[data-reference]").forEach(reset));
</script>
