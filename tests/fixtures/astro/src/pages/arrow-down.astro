---
import { ArrowDown } from "@grave/animated-icons/astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ArrowDown browser test fixture</title>
  </head>
  <body>
    <p><a href="#destination" id="primary"><ArrowDown size={14} />Next section <span>14 px</span></a></p>
    <p><button type="button"><ArrowDown size={24} />Go down <span>24 px</span></button></p>
    <ArrowDown label="Down arrow" id="standalone" />
    <button type="button" id="controlled"><ArrowDown controlled />Manual down</button>
    <button type="button" id="stop-controlled">Stop manual animation</button>

    <button type="button" id="add">Add instance</button>
    <button type="button" id="remove">Remove instance</button>
    <div id="dynamic"></div>
    <template id="instance-template">
      <a href="#destination"><ArrowDown size={16} />Dynamic down link</a>
    </template>
    <p id="destination">Link destination</p>
  </body>
</html>

<script>
  import type { ArrowDownIconHandle } from "@grave/animated-icons/astro";

  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector("#dynamic")!;

  await customElements.whenDefined("grave-arrow-down");
  const controlled = document.querySelector<HTMLElement & ArrowDownIconHandle>("#controlled grave-arrow-down")!;
  document.querySelector("#controlled")!.addEventListener("click", () => controlled.startAnimation());
  document.querySelector("#stop-controlled")!.addEventListener("click", () => controlled.stopAnimation());

  document.querySelector("#add")!.addEventListener("click", () => {
    container.append(template.content.cloneNode(true));
  });
  document.querySelector("#remove")!.addEventListener("click", () => {
    container.lastElementChild?.remove();
  });
</script>
