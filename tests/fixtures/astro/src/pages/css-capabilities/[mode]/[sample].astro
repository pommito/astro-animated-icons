---
import { capabilities, LoaderCircle } from "../../../css-capability-catalogue";

export function getStaticPaths() {
  const samples = [...capabilities.map(icon => icon.slug), "family", "folders", "opacity", "group", "repeated", "mixed", "folders-mixed", "opacity-mixed"];
  return ["baseline", "managed"].flatMap(mode => samples.map(sample => ({ params: { mode, sample } })));
}
const { mode, sample } = Astro.params;
const selected = sample === "repeated" ? Array.from({ length: 20 }, () => capabilities[0])
  : ["family", "mixed"].includes(sample!) ? capabilities : capabilities.filter(icon => icon.slug === sample || icon.family === sample?.replace("-mixed", ""));
---
<html lang="en"><head><meta charset="utf-8" /><title>Capability payload fixture</title></head><body>
  {selected.map(icon => { const Component = mode === "managed" ? icon.Managed : icon.Reference; return <Component />; })}
  {sample?.endsWith("mixed") && <LoaderCircle />}
</body></html>
