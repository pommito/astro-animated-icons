---
import { Archive } from "@grave/animated-icons/astro";
---

<html lang="en">
  <head><title>Archive browser test fixture</title></head>
  <body>
    <p><a href="#destination" id="primary"><Archive size={16} />Archive example</a></p>
    <button type="button" id="secondary"><Archive size={24} />Other archive icon</button>
    <Archive id="standalone" label="Archive icon" />
    <button type="button" id="controlled"><Archive controlled />Manual archive icon</button>
    <button type="button" id="stop-controlled">Stop manual animation</button>
    <button type="button" id="add">Add instance</button>
    <button type="button" id="remove">Remove instance</button>
    <div id="dynamic"></div>
    <template id="instance-template"><a href="#destination"><Archive size={16} />Dynamic archive icon</a></template>
    <p id="destination">Example destination</p>
  </body>
</html>

<script>
  import type { ArchiveIconHandle } from "@grave/animated-icons/astro";

  await customElements.whenDefined("grave-archive");
  const controlled = document.querySelector<HTMLElement & ArchiveIconHandle>("#controlled grave-archive")!;
  document.querySelector("#controlled")!.addEventListener("click", () => controlled.startAnimation());
  document.querySelector("#stop-controlled")!.addEventListener("click", () => controlled.stopAnimation());
  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector("#dynamic")!;
  document.querySelector("#add")!.addEventListener("click", () => container.append(template.content.cloneNode(true)));
  document.querySelector("#remove")!.addEventListener("click", () => container.lastElementChild?.remove());
</script>
