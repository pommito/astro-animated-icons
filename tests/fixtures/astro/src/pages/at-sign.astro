---
import { AtSign } from "@grave/animated-icons/astro";
---

<html lang="en">
  <head><title>AtSign browser test fixture</title></head>
  <body>
    <p><a href="#destination" id="primary"><AtSign size={16} />AtSign example</a></p>
    <button type="button" id="secondary"><AtSign size={24} />Other at-sign icon</button>
    <AtSign id="standalone" label="AtSign icon" />
    <button type="button" id="controlled"><AtSign controlled />Manual at-sign icon</button>
    <button type="button" id="stop-controlled">Stop manual animation</button>
    <button type="button" id="add">Add instance</button>
    <button type="button" id="remove">Remove instance</button>
    <div id="dynamic"></div>
    <template id="instance-template"><a href="#destination"><AtSign size={16} />Dynamic at-sign icon</a></template>
    <p id="destination">Example destination</p>
  </body>
</html>

<script>
  import type { AtSignIconHandle } from "@grave/animated-icons/astro";

  await customElements.whenDefined("grave-at-sign");
  const controlled = document.querySelector<HTMLElement & AtSignIconHandle>("#controlled grave-at-sign")!;
  document.querySelector("#controlled")!.addEventListener("click", () => controlled.startAnimation());
  document.querySelector("#stop-controlled")!.addEventListener("click", () => controlled.stopAnimation());
  const template = document.querySelector<HTMLTemplateElement>("#instance-template")!;
  const container = document.querySelector("#dynamic")!;
  document.querySelector("#add")!.addEventListener("click", () => container.append(template.content.cloneNode(true)));
  document.querySelector("#remove")!.addEventListener("click", () => container.lastElementChild?.remove());
</script>
