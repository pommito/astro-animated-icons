---
import Icon, { type IconProps } from "../../Icon.astro";
import { audioLines } from "./definition";

type Props = IconProps;
---

<Icon {...Astro.props} tag="grave-audio-lines">
  <g>
    <path d="M2 10v3" />
    {audioLines.map(({ x, top, length, normalTop, normalLength }) => (
      <path
        data-audio-line
        d={`M${x} ${top}v${length}`}
        style={normalLength === length ? undefined : `stroke-dasharray: ${normalLength}px ${length}px; stroke-dashoffset: ${top - normalTop}px`}
      />
    ))}
    <path d="M22 10v3" />
  </g>
</Icon>

<script>
  import "./element";
</script>
