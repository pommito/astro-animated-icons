---
import Icon, { type IconProps } from "../../Icon.astro";
type Props = IconProps;
const patternId = `grave-construction-${crypto.randomUUID()}`;
---

<Icon {...Astro.props} tag="grave-construction">
  <g>
    <defs>
      <pattern id={patternId} data-stripes patternUnits="userSpaceOnUse" width="6" height="14">
        <path d="M-4 -2 L14 30" stroke="currentColor" stroke-width="2" data-part="0" />
      </pattern>
    </defs>
    <rect height="8" rx="1" width="20" x="2" y="6" fill={`url(#${patternId})`} data-part="1" />
    <path d="M17 14v7" data-part="2" />
    <path d="M7 14v7" data-part="3" />
    <path d="M17 3v3" data-part="4" />
    <path d="M7 3v3" data-part="5" />
  </g>
</Icon>

<script>
  import "./element";
</script>
