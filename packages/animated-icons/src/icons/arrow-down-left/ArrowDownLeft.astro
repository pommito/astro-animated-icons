---
import Icon, { type IconProps } from "../../Icon.astro";
import { arrowDownLeftPaths, arrowDownLeftOrigins } from "./definition";

type Props = IconProps;
---

<Icon {...Astro.props} tag="grave-arrow-down-left">
  <g>{arrowDownLeftPaths.map((d, index) => <path d={d} style={arrowDownLeftOrigins[index]} />)}</g>
</Icon>

<script>
  import "./element";
</script>
