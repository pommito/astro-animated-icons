{
  "name": "astro-animated-icons-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pnpm --filter @grave/animated-icons check && pnpm --filter @grave/animated-icons-test-fixture check && tsc --noEmit",
    "fixture:build": "node scripts/fixture.mjs build --fresh",
    "fixture:prepare": "node scripts/fixture.mjs build",
    "fixture:serve": "node scripts/fixture.mjs serve",
    "inspect:bundle": "node scripts/fixture.mjs check && node scripts/inspect-bundle.mjs",
    "check:drawings": "node scripts/fixture.mjs check && node scripts/check-drawings.mjs",
    "test": "pnpm fixture:prepare && node --test --test-concurrency=1 scripts/*.test.mjs",
    "validate": "pnpm check && pnpm fixture:prepare && pnpm inspect:bundle && pnpm check:drawings && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
